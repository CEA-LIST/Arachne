        <eStructuralFeatures xsi:type="ecore:EAttribute" name="emv" lowerBound="0" upperBound="1" eType="#//Color"/>
        <eStructuralFeatures xsi:type="ecore:EAttribute" name="elww" lowerBound="0" upperBound="1" eType="#//Color">
