<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="twins" nsURI="http://example.org/ecm1k/twins" nsPrefix="twins">
  <!-- EC.M1k: every attribute of Typed has a twin of the same name in Builtin, typed by the built-in its datatype maps to. -->
  <eClassifiers xsi:type="ecore:EClass" name="Typed">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pbool" eType="#//PBool"/>
