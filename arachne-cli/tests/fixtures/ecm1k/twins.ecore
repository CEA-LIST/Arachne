    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wlong" eType="#//WLong"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wfloat" eType="#//WFloat"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wdouble" eType="#//WDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wchar" eType="#//WChar"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tint" eType="#//TInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="twint" eType="#//TWInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tstring" eType="#//TString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tlist" eType="#//TList"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="udate" eType="#//UDate"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="uarr" eType="#//UArr"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="unone" eType="#//UNone"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="object" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//Object"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wint1" lowerBound="1" eType="#//WInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pbool1" lowerBound="1" eType="#//PBool"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pints" upperBound="-1" eType="#//PInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wdoubles" upperBound="-1" unique="false" eType="#//WDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="dlong" derived="true" volatile="true" transient="true" eType="#//PLong"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="ids" iD="true" eType="#//JString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="state" eType="#//Empty"/>
  </eClassifiers>
