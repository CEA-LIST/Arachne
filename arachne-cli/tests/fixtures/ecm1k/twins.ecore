    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pdouble" eType="#//PDouble"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="pchar" eType="#//PChar"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="jstring" eType="#//JString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wbool" eType="#//WBool"/>
