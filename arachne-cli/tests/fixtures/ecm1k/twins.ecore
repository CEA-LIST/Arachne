    <eStructuralFeatures xsi:type="ecore:EAttribute" name="twint" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tstring" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EChar"/>
