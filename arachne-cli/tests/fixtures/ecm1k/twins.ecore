    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wint" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="wlong" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
