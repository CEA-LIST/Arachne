<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="dt" nsURI="http://example.org/ec06/dt" nsPrefix="dt">
  <eClassifiers xsi:type="ecore:EClass" name="Root">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="label" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="when" eType="#//Date"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="raw" eType="#//Opaque"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="names" eType="#//Generic"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="note" eType="#//Documented"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="Date" instanceClassName="java.util.Date"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Opaque"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Generic" instanceTypeName="java.util.List&lt;java.lang.String&gt;"/>
  <eClassifiers xsi:type="ecore:EDataType" name="Documented" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A note."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" name="Unused" instanceClassName="int"/>
  <eSubpackages name="sub" nsURI="http://example.org/ec06/dt/sub" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EDataType" name="Code" instanceClassName="java.lang.String"/>
  </eSubpackages>
</ecore:EPackage>
