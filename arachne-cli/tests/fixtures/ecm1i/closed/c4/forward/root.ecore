<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="app" nsURI="urn:app" nsPrefix="app">
  <eClassifiers xsi:type="ecore:EClass" name="A">
  </eClassifiers>
  <eSubpackages name="early" nsURI="urn:early" nsPrefix="early">
    <eClassifiers xsi:type="ecore:EClass" name="H">
      <eStructuralFeatures xsi:type="ecore:EReference" name="toT" eType="#//a/b/T"/>
    </eClassifiers>
  </eSubpackages>
  <eSubpackages name="a" nsURI="urn:a" nsPrefix="a">
    <eSubpackages name="b" nsURI="urn:b" nsPrefix="b">
      <eClassifiers xsi:type="ecore:EClass" name="T">
        <eStructuralFeatures xsi:type="ecore:EReference" name="toD" eType="dep.ecore#//D"/>
      </eClassifiers>
    </eSubpackages>
  </eSubpackages>
</ecore:EPackage>
