<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="shop" nsURI="http://example.org/ec05/shop" nsPrefix="shop">
  <eClassifiers xsi:type="ecore:EClass" name="Store">
    <eStructuralFeatures xsi:type="ecore:EReference" name="items" upperBound="-1" eType="#//catalog/Item" containment="true" eKeys="#//catalog/Item/sku"/>
  </eClassifiers>
  <eSubpackages name="catalog" nsURI="http://example.org/ec05/shop/catalog" nsPrefix="cat">
    <eClassifiers xsi:type="ecore:EClass" name="Item" interface="true">
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="sku" lowerBound="1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eStructuralFeatures xsi:type="ecore:EAttribute" name="unit" eType="#//catalog/Unit" defaultValueLiteral="kg"/>
    </eClassifiers>
    <eClassifiers xsi:type="ecore:EEnum" name="Unit">
      <eLiterals name="kg" value="0" literal="KG"/>
      <eLiterals name="piece" value="-1"/>
    </eClassifiers>
  </eSubpackages>
</ecore:EPackage>
