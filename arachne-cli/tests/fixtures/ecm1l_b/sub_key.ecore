<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="subkey" nsURI="http://example.org/ecm1lb/subkey" nsPrefix="subkey">
  <eClassifiers xsi:type="ecore:EEnum" name="Alpha"><eLiterals name="A"/></eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Root">
    <eStructuralFeatures xsi:type="ecore:EReference" name="entries" upperBound="-1" eType="#//Entry" containment="true">
      <eAnnotations source="urn:arachne:semantics">
        <details key="datatype" value="uw-map"/>
        <details key="key-feature" value="key"/>
        <details key="value-feature" value="value"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Entry">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="key" lowerBound="1" eType="#//sub/Shade"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="value" eType="#//Alpha"/>
  </eClassifiers>
  <eSubpackages name="sub" nsURI="http://example.org/ecm1lb/subkey/sub" nsPrefix="sub">
    <eClassifiers xsi:type="ecore:EEnum" name="Shade"><eLiterals name="DARK"/><eLiterals name="LIGHT" value="1"/></eClassifiers>
  </eSubpackages>
</ecore:EPackage>
